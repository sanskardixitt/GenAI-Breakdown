    {
      "id": "e055",
      "type": "text",
      "x": 74,
      "y": 1006.0,
      "width": 536.25,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
