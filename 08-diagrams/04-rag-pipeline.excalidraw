    {
      "id": "e069",
      "type": "text",
      "x": 774,
      "y": 946.0,
      "width": 607.75,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
