      "roundness": null,
      "seed": 69904,
      "version": 1,
      "versionNonce": 546411,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "Step 1: kya SAHI chunk index mein hai bhi? (agar nahi → ingest problem)\nStep 2: kya wo top-50 retrieval mein aaya? (recall@50 measure karo)\nStep 3: kya rerank ke baad top-5 mein aaya? (reranker problem)\nStep 4: chunk context mein tha par answer galat? (ab prompt/model problem)\n\n90% log step 4 pe prompt tweak karte rehte hain jabki problem step 1–2 mein hoti hai.",
      "originalText": "Step 1: kya SAHI chunk index mein hai bhi? (agar nahi → ingest problem)\nStep 2: kya wo top-50 retrieval mein aaya? (recall@50 measure karo)\nStep 3: kya rerank ke baad top-5 mein aaya? (reranker problem)\nStep 4: chunk context mein tha par answer galat? (ab prompt/model problem)\n\n90% log step 4 pe prompt tweak karte rehte hain jabki problem step 1–2 mein hoti hai.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
